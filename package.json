{
  "name": "@proof-computer/switchboard-express-demo",
  "version": "0.2.7",
  "description": "Rich Express demo app for Switchboard launch-demo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proof-computer/switchboard-express-demo.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "preview": "npm run build && node scripts/preview.mjs",
    "visual": "npm run build && node scripts/visual.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@proof-computer/switchboard-express": "0.2.7",
    "@proof-computer/switchboard-runtime": "0.1.6",
    "@proof-computer/switchboard-workflows": "0.1.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@proof-computer/switchboard-express",
      "@proof-computer/switchboard-runtime",
      "@proof-computer/switchboard-workflows"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
